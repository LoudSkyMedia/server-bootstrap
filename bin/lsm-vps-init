#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED_SOURCE="$(readlink -f "$SOURCE_PATH" 2>/dev/null || true)"
  if [[ -n "$RESOLVED_SOURCE" ]]; then
    SOURCE_PATH="$RESOLVED_SOURCE"
  fi
fi

SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
SOURCE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEFAULT_INSTALLED_ROOT="/usr/local/lib/lsm-vps-init"
TMUX_SESSION="${LSM_VPS_INIT_TMUX_SESSION:-lsm-vps-init}"

filtered_args=()
no_tmux=0
skip_tmux=0
for arg in "$@"; do
  case "$arg" in
    --no-tmux|--dry-run|--mock-root|--non-interactive|status|verify-ssh|record-ssh-proof|confirm-relay)
      [[ "$arg" == "--no-tmux" ]] && no_tmux=1
      [[ "$arg" != "--no-tmux" ]] && filtered_args+=("$arg")
      skip_tmux=1
      ;;
    *)
      filtered_args+=("$arg")
      ;;
  esac
done

if [[ "$no_tmux" -eq 0 && "$skip_tmux" -eq 0 && -z "${TMUX:-}" && -t 0 && -t 1 ]]; then
  if command -v tmux >/dev/null 2>&1; then
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
      printf 'Bootstrap is running inside tmux session: %s\n' "$TMUX_SESSION" >&2
      printf 'Detach: Ctrl-b then d\n' >&2
      printf 'Reattach: sudo tmux attach-session -t %s\n' "$TMUX_SESSION" >&2
    else
      printf 'Bootstrap is running inside tmux session: %s\n' "$TMUX_SESSION" >&2
      printf 'Detach: Ctrl-b then d\n' >&2
      printf 'Reattach: tmux attach-session -t %s\n' "$TMUX_SESSION" >&2
    fi
    exec tmux new-session -A -s "$TMUX_SESSION" -- bash -lc '
      session="$1"
      shift
      launcher="$1"
      printf "Bootstrap is running inside tmux session: %s\n\n" "$session"
      "$@"
      rc=$?
      printf "\n"
      case "$rc" in
        0)
          printf "Loud Sky Media VPS initialization completed successfully.\n"
          ;;
        2)
          printf "Bootstrap paused at a required checkpoint.\n\n"
          "$launcher" --no-tmux status || true
          ;;
        *)
          printf "Bootstrap stopped because a stage failed.\n\n"
          "$launcher" --no-tmux status || true
          ;;
      esac
      printf "\nDiagnostic log: /var/log/lsm-vps-init/bootstrap.log\n"
      printf "Resume after repair: sudo lsm-vps-init resume\n"
      if [ -t 0 ]; then
        printf "\nPress Enter to close this tmux pane, or detach with Ctrl-b then d.\n"
        IFS= read -r _unused || true
      fi
      exit "$rc"
    ' bash "$TMUX_SESSION" "$0" --no-tmux "${filtered_args[@]}"
  else
    printf 'tmux is not installed yet; continuing without tmux. Persistent state still supports resume.\n' >&2
  fi
fi

APP_ROOT="${LSM_VPS_INIT_APP_ROOT:-}"
if [[ -z "$APP_ROOT" ]]; then
  if [[ -f "$SOURCE_ROOT/lsm_vps_init/__init__.py" ]]; then
    APP_ROOT="$SOURCE_ROOT"
  elif [[ -f "$DEFAULT_INSTALLED_ROOT/lsm_vps_init/__init__.py" ]]; then
    APP_ROOT="$DEFAULT_INSTALLED_ROOT"
  else
    printf 'ERROR: cannot find lsm_vps_init Python package. Checked %s and %s.\n' "$SOURCE_ROOT" "$DEFAULT_INSTALLED_ROOT" >&2
    exit 127
  fi
elif [[ ! -f "$APP_ROOT/lsm_vps_init/__init__.py" ]]; then
  printf 'ERROR: LSM_VPS_INIT_APP_ROOT does not contain lsm_vps_init Python package: %s\n' "$APP_ROOT" >&2
  exit 127
fi

export PYTHONPATH="$APP_ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m lsm_vps_init.cli "${filtered_args[@]}"
